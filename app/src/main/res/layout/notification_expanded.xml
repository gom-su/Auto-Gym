<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@android:color/transparent">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/notification_text"/>
    <TextView android:id="@+id/rest_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="3" android:textSize="12sp" android:textColor="@color/notification_text" android:visibility="gone"/>
    <LinearLayout android:id="@+id/set_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:id="@+id/weight_minus" style="@style/NotificationControl" android:layout_width="32dp" android:text="−" android:contentDescription="Reducir peso"/>
            <TextView android:id="@+id/weight" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/notification_text" android:textSize="13sp"/>
            <TextView android:id="@+id/weight_plus" style="@style/NotificationControl" android:layout_width="32dp" android:text="+" android:contentDescription="Aumentar peso"/>
            <TextView android:id="@+id/reps_minus" style="@style/NotificationControl" android:layout_width="32dp" android:text="−" android:contentDescription="Reducir repeticiones"/>
            <TextView android:id="@+id/reps" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/notification_text" android:textSize="13sp"/>
            <TextView android:id="@+id/reps_plus" style="@style/NotificationControl" android:layout_width="32dp" android:text="+" android:contentDescription="Aumentar repeticiones"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/notification_rir" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:baselineAligned="false">
            <TextView android:layout_width="32dp" android:layout_height="wrap_content" android:text="RIR" android:textSize="12sp" android:textColor="@color/notification_text"/>
            <TextView android:id="@+id/rir0" style="@style/NotificationControl" android:layout_height="40dp" android:layout_width="0dp" android:layout_weight="1" android:text="0"/>
            <TextView android:id="@+id/rir1" style="@style/NotificationControl" android:layout_height="40dp" android:layout_width="0dp" android:layout_weight="1" android:text="1"/>
            <TextView android:id="@+id/rir2" style="@style/NotificationControl" android:layout_height="40dp" android:layout_width="0dp" android:layout_weight="1" android:text="2"/>
            <TextView android:id="@+id/rir3" style="@style/NotificationControl" android:layout_height="40dp" android:layout_width="0dp" android:layout_weight="1" android:text="3"/>
            <TextView android:id="@+id/rir4" style="@style/NotificationControl" android:layout_height="40dp" android:layout_width="0dp" android:layout_weight="1" android:text="4+"/>
        </LinearLayout>
        <TextView android:id="@+id/complete" style="@style/NotificationControl" android:layout_height="40dp" android:layout_width="match_parent" android:background="@drawable/notification_primary" android:text="Completar serie"/>
    </LinearLayout>
    <TextView android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/notification_text" android:visibility="gone"/>
    <LinearLayout android:id="@+id/rest_controls" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:baselineAligned="false" android:visibility="gone">
        <TextView android:id="@+id/reduce_rest" style="@style/NotificationControl" android:layout_width="0dp" android:layout_weight="1" android:text="−15 s"/>
        <TextView android:id="@+id/add_rest" style="@style/NotificationControl" android:layout_width="0dp" android:layout_weight="1" android:text="+15 s"/>
        <TextView android:id="@+id/skip_rest" style="@style/NotificationControl" android:layout_width="0dp" android:layout_weight="2" android:text="Saltar descanso" android:maxLines="2" android:textSize="13sp" android:background="@drawable/notification_primary"/>
    </LinearLayout>
    <TextView android:id="@+id/wait_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/notification_text" android:text="Espera al terminar el descanso" android:visibility="gone"/>
    <TextView android:id="@+id/machine_wait" style="@style/NotificationControl" android:layout_width="match_parent" android:layout_height="40dp" android:textSize="13sp" android:text="Iniciar espera" android:visibility="gone"/>
    <TextView android:id="@+id/edit_last" style="@style/NotificationControl" android:layout_width="match_parent" android:layout_height="40dp" android:textSize="13sp" android:text="Editar última serie" android:visibility="gone"/>
</LinearLayout>
