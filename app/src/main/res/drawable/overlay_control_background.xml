<!-- Floating-panel control: soft tonal square that brightens while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#4DB4EE80"/><corners android:radius="12dp"/></shape></item>
    <item><shape><solid android:color="#1FFFFFFF"/><corners android:radius="12dp"/></shape></item>
</selector>
